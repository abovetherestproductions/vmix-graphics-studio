# Dependencies
node_modules/

# Live runtime data — changes per competition, not part of the codebase.
# Config is layered so that `git pull` can update installs in the field without
# ever overwriting what an operator has changed:
#   style-defaults.json — the studio's look → TRACKED. Ships with each update.
#                         Nothing on a user's machine writes to it, so it is
#                         never locally modified and a pull always fast-forwards.
#   style-config.json   — ONLY the settings this machine changed from those
#                         defaults → IGNORED. Untouched settings stay absent and
#                         keep inheriting, so new defaults reach every install.
#   event-state.json    — active segment, workbook paths, API-derived names →
#                         IGNORED (machine-local; a pull never clobbers a
#                         machine's live event).
#   event-config.json   — derived merged cache the graphics read → IGNORED.
public/data/*.json
!public/data/style-defaults.json
config/current-state.json
config/history/
# vMix host/port, overlay mappings and recording folders — per-machine, and
# Production Control writes to it. Tracking it would make a pull fail on any
# machine whose operator has changed a setting. Defaults ship in
# src/modules/settings.js and the file is recreated on first run.
config/settings.json

# Logs
logs/
*.log

# Event-specific input files
CSV Data/
manual skater list/
# Operator-uploaded workbooks (messages, etc.) — machine-local, re-upload per install
uploads/
# Event spreadsheets — these carry skater and coach names, so they must never
# ship to another install. Load them per-machine via Tools → Event Workbooks,
# which stores them under uploads/.
*.xlsx
*.xls

# macOS
.DS_Store
**/.DS_Store

# Environment / secrets (precaution)
.env
.env.*

# Internal working notes — kept locally, not part of what ships
PROMPT-FOR-CODEX-CLAUDE.md
TECHNICAL-BRIEF-FOR-CODEX-CLAUDE.md

# Stale duplicate of an earlier build, kept locally for reference only
scan this/

# Dev-only reference material — not needed to run the app
screenshots of current graphics/
.claude/
tools/write-sample-starting-order.js

# Saved config presets are event- and machine-specific (they carry event names
# and local workbook paths). Operators create their own from the operator UI.
config/presets/

